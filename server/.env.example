# CivicLens backend config
PORT=8000
HOST=127.0.0.1

# AI classification (optional — falls back to a local heuristic if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite location (defaults to server/data/civiclens.db)
# DB_PATH=/home/trench/civiclens/server/data/civiclens.db

# WhatsApp intake via Twilio (optional). Text replies work with just the SID;
# fetching photos + verifying signatures needs the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public frontend base, used to put a Track link in the WhatsApp reply.
# FRONTEND_URL=https://your-app.vercel.app
